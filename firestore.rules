rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'omotoshomichael2503@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin();
    }

    match /contact_messages/{messageId} {
      // Public visitors can submit contact messages with validation
      allow create: if request.resource.data.fullName is string &&
                       request.resource.data.fullName.size() >= 2 &&
                       request.resource.data.fullName.size() <= 100 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.size() >= 5 &&
                       request.resource.data.email.size() <= 100 &&
                       request.resource.data.phone is string &&
                       request.resource.data.phone.size() <= 40 &&
                       request.resource.data.companyName is string &&
                       request.resource.data.companyName.size() <= 120 &&
                       request.resource.data.subject is string &&
                       request.resource.data.subject.size() >= 2 &&
                       request.resource.data.subject.size() <= 150 &&
                       request.resource.data['service'] is string &&
                       request.resource.data['service'].size() >= 2 &&
                       request.resource.data['service'].size() <= 100 &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() >= 5 &&
                       request.resource.data.message.size() <= 4000 &&
                       request.resource.data.status == 'new' &&
                       request.resource.data.isRead == false;

      // Only authenticated and authorized administrators can read, update, or delete
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
